import sbvr_helpers;
import UCD_transformations;

modeltype UML uses 'http://www.eclipse.org/uml2/4.0.0/UML';

transformation uml2sbvr( in src : UML, in prof: UML, in prof2: UML, in prof3: UML, in extprof: UML, in sbvrprof: UML, out dest : UML  );

main() {
    var profile : Profile := prof.objectsOfType(Profile)![name = "Meaning and Representation Vocabulary"];
    var profrules : Profile := prof2.objectsOfType(Profile)![name = "Vocabulary for Describing Business Rules"];
    var profvoc : Profile := prof3.objectsOfType(Profile)![name = "Vocabulary for Describing Business Vocabularies"];
    var profext : Profile := extprof.objectsOfType(Profile)![name = "Extension for SBVR"];
    var profsbvr : Profile := sbvrprof.objectsOfType(Profile)![name = "SBVR Profile"];
    initStereotypes(profile, profrules, profvoc, profext, profsbvr);
    initPackages(false, true);
    var srcPackage: Package := src.objectsOfType(Package)->select(ownedComment->select(body.startsWith("_trans_owner_"))->notEmpty())->asOrderedSet()->first(); 
    src.objectsOfType(Actor)->select(inPackage(srcPackage)).map transformActorMV();
    src.objectsOfType(UseCase)->select(inPackage(srcPackage)).map transformUseCaseMV();
    src.objectsOfType(Classifier)->select(inPackage(srcPackage)).map transformBoundaryMV();
    src.objectsOfType(Model)->select(inPackage(srcPackage)).map transformBoundaryMV();
    src.objectsOfType(Component)->select(inPackage(srcPackage)).map transformBoundaryMV();
    src.objectsOfType(Association)->select(inPackage(srcPackage)).map transformUseCaseAssociationMV();
    src.objectsOfType(Generalization)->select(inPackage(srcPackage)).map transformActorGeneralizationMV();
    src.objectsOfType(Generalization)->select(inPackage(srcPackage)).map useCaseGeneralizationMV();
    src.objectsOfType(Include)->select(inPackage(srcPackage)).map transformIncludeRelationshipsMV();
    src.objectsOfType(Extend)->select(inPackage(srcPackage)).map transformExtendRelationshipsMV(); 
    src.objectsOfType(ExtensionPoint)->select(inPackage(srcPackage)).map transformExtensionPointMV();
}
